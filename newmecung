            <div class="option-item" data-map="gold" style="border-color:#ffe600">Golden Gold</div>
          </div>
        </div>

        <button id="btn-start" class="btn">CHƠI NGAY ▶</button>
      </div>

      <!-- Màn hình chọn màn chơi -->
      <div id="level-screen" class="screen hidden">
        <h2>CHỌN MÀN CHƠI</h2>
        <div class="level-grid" id="level-grid"></div>
        <button id="btn-back-start" class="btn btn-secondary">QUAY LẠI MENU</button>
