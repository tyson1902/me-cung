    <div id="game-wrapper">
      <canvas id="gameCanvas" width="480" height="480"></canvas>

      <div id="toast-msg">Thông báo</div>

      <!-- Màn hình chính -->
      <div id="start-screen" class="screen">
        <h1>MÊ CUNG NEON</h1>
        <p>Hòa mình vào giai điệu nhạc Chill quốc tế & tùy biến Neon rực rỡ!</p>

        <div class="selection-box">
          <div class="selection-title">Chọn Skin Nhân Vật</div>
