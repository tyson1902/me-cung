<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Mê Cung Neon Deluxe - Chill & Skins</title>
  <style>
    :root {
      --bg-color: #060814;
      --panel-bg: rgba(18, 24, 48, 0.95);
      --primary: #00f0ff;
      --secondary: #ff007f;
      --accent: #ffe600;
      --text: #ffffff;
      --map-theme-glow: #00f0ff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10px;
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(0, 240, 255, 0.2) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(255, 0, 127, 0.2) 0%, transparent 40%);
    }

    .container {
      position: relative;
      width: 100%;
      max-width: 520px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    header {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      padding: 10px 15px;
      background: var(--panel-bg);
      backdrop-filter: blur(12px);
      border-radius: 16px;
      border: 1px solid rgba(0, 240, 255, 0.4);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.2);
    }

    .title {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--primary);
      text-shadow: 0 0 10px var(--primary);
    }

    .stats-bar {
      display: flex;
      gap: 8px;
      font-size: 0.9rem;
    }

    .stat-item {
      display: flex;
      align-items: center;
      gap: 4px;
      background: rgba(255, 255, 255, 0.08);
      padding: 5px 10px;
      border-radius: 8px;
      font-weight: bold;
    }

    .stat-value {
      color: var(--accent);
    }

    .top-controls {
      display: flex;
      gap: 6px;
    }

    #game-wrapper {
      position: relative;
      width: 100%;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 0 35px var(--map-theme-glow);
      border: 3px solid var(--primary);
      background: #020308;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    canvas {
      display: block;
    }

    #toast-msg {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(255, 0, 127, 0.95);
      color: #fff;
      padding: 8px 18px;
      border-radius: 20px;
      font-weight: bold;
      font-size: 0.95rem;
      box-shadow: 0 0 15px rgba(255, 0, 127, 0.6);
      z-index: 30;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    #toast-msg.show {
      opacity: 1;
    }

    .screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(6, 8, 20, 0.96);
      backdrop-filter: blur(12px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 20;
      padding: 25px;
      text-align: center;
      transition: opacity 0.3s ease;
    }

    .screen.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .screen h1 {
      font-size: 2.2rem;
      color: var(--primary);
      text-shadow: 0 0 15px var(--primary);
      margin-bottom: 10px;
    }

    .screen h2 {
      font-size: 1.5rem;
      color: var(--secondary);
      margin-bottom: 15px;
    }

    .screen p {
      color: #a0a5c0;
      margin-bottom: 15px;
      font-size: 0.95rem;
      line-height: 1.4;
    }

    .btn {
      background: linear-gradient(135deg, var(--primary), #0077ff);
      color: #000;
      font-weight: 800;
      border: none;
      padding: 12px 26px;
      font-size: 1rem;
      border-radius: 30px;
      cursor: pointer;
      box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
      transition: all 0.2s ease;
      margin: 5px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.8);
    }

    .btn-secondary {
      background: linear-gradient(135deg, var(--secondary), #a000ff);
      color: #fff;
      box-shadow: 0 0 20px rgba(255, 0, 127, 0.4);
    }

    .btn-hint {
      background: linear-gradient(135deg, #ffe600, #ff8800);
      color: #000;
      box-shadow: 0 0 15px rgba(255, 230, 0, 0.4);
      font-size: 0.9rem;
      padding: 10px 20px;
    }

    .btn-icon {
      width: 38px;
      height: 38px;
      padding: 0;
      border-radius: 50%;
      font-size: 1.1rem;
    }

    .level-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      width: 100%;
      max-width: 340px;
      margin-bottom: 15px;
      max-height: 200px;
      overflow-y: auto;
      padding: 5px;
    }

    .level-btn {
      background: var(--panel-bg);
      border: 2px solid rgba(0, 240, 255, 0.3);
      color: #fff;
      padding: 12px 0;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: bold;
      cursor: pointer;
    }

    .level-btn.unlocked {
      border-color: var(--primary);
      color: var(--primary);
    }

    .level-btn.unlocked:hover {
      background: var(--primary);
      color: #000;
    }

    .level-btn.locked {
      opacity: 0.35;
      cursor: not-allowed;
    }

    /* Selection panels inside modal */
    .selection-box {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 12px;
      margin-bottom: 15px;
      width: 100%;
      max-width: 380px;
    }

    .selection-title {
      font-size: 0.85rem;
      font-weight: bold;
      color: var(--primary);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .grid-options {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .option-item {
      padding: 8px 14px;
      border-radius: 10px;
      background: var(--panel-bg);
      border: 2px solid #333;
      color: #fff;
      font-size: 0.9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .option-item.selected {
      border-color: var(--accent);
      box-shadow: 0 0 12px var(--accent);
      background: rgba(255, 230, 0, 0.15);
      color: var(--accent);
    }

    .bottom-bar {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 10px;
    }

    .touch-controls {
      display: grid;
      grid-template-columns: repeat(3, 58px);
      grid-template-rows: repeat(3, 58px);
      gap: 6px;
      margin-top: 10px;
    }

    .dbtn {
      background: var(--panel-bg);
      border: 2px solid rgba(0, 240, 255, 0.4);
      color: var(--primary);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }

    .dbtn:active {
      background: var(--primary);
      color: #000;
      transform: scale(0.95);
    }

    .dbtn-up { grid-column: 2; grid-row: 1; }
    .dbtn-left { grid-column: 1; grid-row: 2; }
    .dbtn-down { grid-column: 2; grid-row: 3; }
    .dbtn-right { grid-column: 3; grid-row: 2; }

    @media (min-width: 768px) {
      .touch-controls {
        display: none;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <div class="title">🌌 Mê Cung Neon</div>
      <div class="stats-bar">
        <div class="stat-item">Màn: <span id="current-level-display" class="stat-value">1</span></div>
        <div class="stat-item">💎 <span id="gems-display" class="stat-value">10</span></div>
      </div>
      <div class="top-controls">
        <!-- 2 icon điều chỉnh âm nhạc & skin/map trực tiếp -->
        <button id="btn-music-toggle" class="btn btn-secondary btn-icon" title="Đổi Nhạc Chill">🎵</button>
        <button id="btn-custom-toggle" class="btn btn-icon" title="Đổi Skin & Map">🎨</button>
