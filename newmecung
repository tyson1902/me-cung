      <!-- Bảng tùy chỉnh nhanh khi bấm icon cọ vẽ 🎨 trong game -->
      <div id="custom-screen" class="screen hidden">
        <h2>TÙY CHỈNH NHANH</h2>
        
        <div class="selection-box">
          <div class="selection-title">Đổi Skin Nhân Vật</div>
          <div class="grid-options" id="modal-skin-options">
            <div class="option-item" data-skin="🟢">🟢 Ball</div>
            <div class="option-item" data-skin="🤖">🤖 Robot</div>
            <div class="option-item" data-skin="🐱">🐱 Neko</div>
            <div class="option-item" data-skin="🚀">🚀 Rocket</div>
            <div class="option-item" data-skin="👻">👻 Ghost</div>
          </div>
        </div>

        <div class="selection-box">
          <div class="selection-title">Đổi Giao Diện Map</div>
          <div class="grid-options" id="modal-map-options">
